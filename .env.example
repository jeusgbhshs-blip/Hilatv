# Local development defaults. Copy to .env to override.
# These values are development-only. Vendor keys stay empty until a live adapter exists.

POSTGRES_USER=hilatv
POSTGRES_PASSWORD=hilatv_dev
POSTGRES_DB=hilatv
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hilatv:hilatv_dev@localhost:5432/hilatv
# Alembic rewrites postgresql:// to postgresql+psycopg://. No extra variable.

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

MINIO_ROOT_USER=hilatv
MINIO_ROOT_PASSWORD=hilatv_dev_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=hilatv
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1

# Production OSS uses the same client. Empty S3_* values keep the MinIO settings above.
# S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_REGION=oss-cn-hangzhou
# S3_ADDRESSING=virtual
HILATV_OBJECT_URI_SCHEME=oss
HILATV_POLL_INTERVAL_S=2

TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8088
TEMPORAL_ADDRESS=localhost:7233

HILATV_ENV=development
HILATV_LIVE=0
HILATV_BUDGET_CNY=0
HILATV_DAILY_BUDGET_CNY=0

# Vendor keys. Leave empty; CI and local runs use the mock adapter.
# HILATV_LIVE=1 and a non-zero budget are both required before a real call.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=

# Seedream / Seedance. Empty falls back to ARK_API_KEY (same Ark project).
SEEDREAM_API_KEY=
SEEDANCE_API_KEY=
SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_MODEL=
SEEDANCE_MODEL=

# Doubao speech. Live TTS needs both the app id and the access token.
VOLC_TTS_APP_ID=
VOLC_TTS_API_KEY=
VOLC_TTS_CLUSTER=volcano_tts
VOLC_TTS_VOICE=zh_male_M392_conversation_wvae_bigtts
VOLC_TTS_BASE_URL=https://openspeech.bytedance.com
VOLC_TTS_MODEL=

# OpenAI-compatible base URLs. Override only if the vendor moves the endpoint.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Optional model overrides. Empty keeps the name in gateway/routes.yaml.
# Ark often needs an endpoint id here (ep-...).
DEEPSEEK_MODEL=
DASHSCOPE_MODEL=
ARK_MODEL=

HILATV_LLM_TIMEOUT_S=60
HILATV_CACHE_TTL_S=86400
# auto uses Postgres when DATABASE_URL answers, otherwise SQLite.
# Postgres call_logs/alerts come from `alembic upgrade head` (t03_gateway_0002).
# HILATV_GATEWAY_STORE=auto
# HILATV_SQLITE_PATH=
# HILATV_ROUTES_PATH=
# HILATV_PRICING_PATH=
# HILATV_PROGRESS_PATH=

# N4 script and N5 storyboard reuse the LLM keys above. No extra vendor.
# Shot-language presets live in templates/shots. Override only in tests.
# HILATV_SHOT_TEMPLATES=

# N8 keyframes and N10 image-to-video reuse the image and video keys above.
# Default candidate counts are 4 per shot (pass keyframe_candidates / video_candidates
# on the node input to change them). N10 trims a 5s or 10s generation down to the
# shot length and leaves HILATV_TRIM_MARGIN_S unused at the head, with the rest of
# the spare at the tail.
# HILATV_SHOT_WORKERS=4
# HILATV_TRIM_MARGIN_S=0.2

# N1 attachment fetch. No vendor key. HTML is read as UTF-8.
HILATV_N1_FETCH_TIMEOUT_S=10
HILATV_N1_FETCH_MAX_BYTES=2000000
# Optional override for templates/industries.
# HILATV_INDUSTRY_TEMPLATES=
