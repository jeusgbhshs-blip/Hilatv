# Local development defaults. Copy to .env to override.
# These values are development-only. Vendor keys stay empty until a live adapter exists.

POSTGRES_USER=hilatv
POSTGRES_PASSWORD=hilatv_dev
POSTGRES_DB=hilatv
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hilatv:hilatv_dev@localhost:5432/hilatv
# Alembic rewrites postgresql:// to postgresql+psycopg://. No extra variable.

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

MINIO_ROOT_USER=hilatv
MINIO_ROOT_PASSWORD=hilatv_dev_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=hilatv
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1

# Production OSS uses the same client. Empty S3_* values keep the MinIO settings above.
# S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_REGION=oss-cn-hangzhou
# S3_ADDRESSING=virtual
HILATV_OBJECT_URI_SCHEME=oss
HILATV_POLL_INTERVAL_S=2

TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8088
TEMPORAL_ADDRESS=localhost:7233

# embedded: in-process Temporal dev server (default, no Docker).
# remote: connect to TEMPORAL_ADDRESS and run `hilatv worker` in another process.
# skip is the time-skipping test server; local keeps real activity timeouts.
HILATV_TEMPORAL_MODE=embedded
# HILATV_TEMPORAL_CLOCK=local
# HILATV_TASK_QUEUE=hilatv
# HILATV_PROJECT_DIR=
# Main workflow asks N8/N10 for 3 candidates (the SPEC minimum). Raise up to 8.
# HILATV_KEYFRAME_CANDIDATES=3
# HILATV_VIDEO_CANDIDATES=3

HILATV_ENV=development
HILATV_LIVE=0
HILATV_BUDGET_CNY=0
HILATV_DAILY_BUDGET_CNY=0

# Vendor keys. Leave empty; CI and local runs use the mock adapter.
# HILATV_LIVE=1 and a non-zero budget are both required before a real call.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=

# Seedream / Seedance. Empty falls back to ARK_API_KEY (same Ark project).
SEEDREAM_API_KEY=
SEEDANCE_API_KEY=
SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_MODEL=
SEEDANCE_MODEL=

# Doubao speech. Live TTS needs both the app id and the access token.
VOLC_TTS_APP_ID=
VOLC_TTS_API_KEY=
VOLC_TTS_CLUSTER=volcano_tts
VOLC_TTS_VOICE=zh_male_M392_conversation_wvae_bigtts
VOLC_TTS_BASE_URL=https://openspeech.bytedance.com
VOLC_TTS_MODEL=

# Doubao / Volcengine ASR. Empty stays on the mock adapter. Not the TTS token.
VOLC_ASR_APP_ID=
VOLC_ASR_API_KEY=
VOLC_ASR_RESOURCE_ID=volc.bigasr.auc_turbo
VOLC_ASR_BASE_URL=https://openspeech.bytedance.com

# OpenAI-compatible base URLs. Override only if the vendor moves the endpoint.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Optional model overrides. Empty keeps the name in gateway/routes.yaml.
# Ark often needs an endpoint id here (ep-...).
DEEPSEEK_MODEL=
DASHSCOPE_MODEL=
ARK_MODEL=

HILATV_LLM_TIMEOUT_S=60
HILATV_CACHE_TTL_S=86400
# auto uses Postgres when DATABASE_URL answers, otherwise SQLite.
# Postgres call_logs/alerts come from `alembic upgrade head` (t03_gateway_0002).
# HILATV_GATEWAY_STORE=auto
# HILATV_SQLITE_PATH=
# HILATV_ROUTES_PATH=
# HILATV_PRICING_PATH=
# HILATV_PROGRESS_PATH=

# N6 pronunciation dictionary. Empty uses workers/nodes/n06_voiceover/lexicon.yaml.
# HILATV_N6_LEXICON=

# N4 script and N5 storyboard reuse the LLM keys above. No extra vendor.
# Shot-language presets live in templates/shots. Override only in tests.
# HILATV_SHOT_TEMPLATES=

# N9 / N11 vision judges. Empty keys stay on the mock judge.
# Qwen-VL uses DASHSCOPE_API_KEY above. Gemini is the second judge.
# HILATV_LIVE=1 and a non-zero budget are both required before either call is billed.
QWEN_VL_MODEL=qwen-vl-max
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.0-flash

# N9/N11 measurement thresholds. T13 reuses the same names. The 7.5 pass line
# and the 3 reviews per shot are fixed by SPEC and are not settings.
# HILATV_QA_DEFORM_MIN_SIMILARITY=0.90
# HILATV_QA_FACE_MIN_SIMILARITY=0.75
# HILATV_QA_MIN_EDGE=240
# HILATV_QA_FLICKER_DELTA=0.22
# HILATV_QA_FLICKER_NEIGHBOR=0.08
# Extra regenerate/switch-model decisions allowed for a whole project.
# HILATV_QA_PROJECT_RETRIES=12

# T16 dialogue edits always use the mock gateway in-process. Leave HILATV_LIVE at 0.
# Female voice name used when an edit asks for 女声. Not a vendor credential.
# HILATV_REVISION_FEMALE_VOICE=zh_female_steady

# N8 keyframes and N10 image-to-video reuse the image and video keys above.
# Default candidate counts are 4 per shot (pass keyframe_candidates / video_candidates
# on the node input to change them). N10 trims a 5s or 10s generation down to the
# shot length and leaves HILATV_TRIM_MARGIN_S unused at the head, with the rest of
# the spare at the tail.
# HILATV_SHOT_WORKERS=4
# HILATV_TRIM_MARGIN_S=0.2

# N17 reframe and multi-language export. TTS and a vertical plate go through
# the gateway (mock when there is no key). English uses that same TTS route.
# HILATV_N17_LONG_EDGE=
# HILATV_N17_REGENERATE=0
# How many exports may run at once. Further requests get HTTP 429.
# HILATV_N17_EXPORT_SLOTS=2
# Share links expire after this many seconds. Default is 7 days.
# HILATV_SHARE_TTL_S=604800

# N13 subtitles, N14 packaging, N15 FFmpeg compose. No vendor key.
# Fonts default to templates/packaging/fonts (Noto Sans CJK SC, OFL).
# HILATV_FONT_DIR=
# HILATV_PACKAGING_DIR=
# Empty width/height keeps 1280x720, 720x1280, or 720x720 from the aspect ratio.
# HILATV_RENDER_WIDTH=
# HILATV_RENDER_HEIGHT=

# N2 Brand Kit files (logo cutouts, mono plates). Empty uses <project dir>/_brands.
# No extra vendor key. Matting is local. Anchor angles reuse the image key above.
# HILATV_BRAND_DIR=
# N3 concept cards reuse the LLM and image keys. No extra vendor.

# N1 attachment fetch. No vendor key. HTML is read as UTF-8.
HILATV_N1_FETCH_TIMEOUT_S=10
HILATV_N1_FETCH_MAX_BYTES=2000000
# Optional override for templates/industries.
# HILATV_INDUSTRY_TEMPLATES=

# T18 benchmark. Default is mock (N1–N5). live still obeys the budget guard.
# HILATV_EVAL_MODE=mock
# HILATV_EVAL_OUT=

# Web (T11). No vendor key. The browser calls this API.
# Empty NEXT_PUBLIC_API_BASE keeps requests on the Next origin, which rewrites /v1.
# Set both when the page and the API are on different ports.
# HILATV_API_ORIGIN=http://127.0.0.1:8000
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
# HILATV_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# HILATV_UPLOAD_MAX_BYTES=8388608
# Accept ports. Defaults are 8765 and 3456 so they do not collide with make api.
# HILATV_ACCEPT_API_PORT=8765
# HILATV_ACCEPT_WEB_PORT=3456
