# Local development defaults. Copy to .env to override.
# These values are development-only. Vendor keys stay empty until a live adapter exists.

POSTGRES_USER=hilatv
POSTGRES_PASSWORD=hilatv_dev
POSTGRES_DB=hilatv
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hilatv:hilatv_dev@localhost:5432/hilatv
# Alembic rewrites postgresql:// to postgresql+psycopg://. No extra variable.

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

MINIO_ROOT_USER=hilatv
MINIO_ROOT_PASSWORD=hilatv_dev_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=hilatv
MINIO_ENDPOINT=http://localhost:9000

TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8088
TEMPORAL_ADDRESS=localhost:7233

HILATV_ENV=development
HILATV_LIVE=0
HILATV_BUDGET_CNY=0
HILATV_DAILY_BUDGET_CNY=0

# Vendor keys. Leave empty; CI and local runs use the mock adapter.
# HILATV_LIVE=1 and a non-zero budget are both required before a real call.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=
VOLC_TTS_API_KEY=

# OpenAI-compatible base URLs. Override only if the vendor moves the endpoint.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Optional model overrides. Empty keeps the name in gateway/routes.yaml.
# Ark often needs an endpoint id here (ep-...).
DEEPSEEK_MODEL=
DASHSCOPE_MODEL=
ARK_MODEL=

HILATV_LLM_TIMEOUT_S=60
HILATV_CACHE_TTL_S=86400
# auto uses Postgres when DATABASE_URL answers, otherwise SQLite.
# Postgres call_logs/alerts come from `alembic upgrade head` (t03_gateway_0002).
# HILATV_GATEWAY_STORE=auto
# HILATV_SQLITE_PATH=
# HILATV_ROUTES_PATH=
# HILATV_PRICING_PATH=
# HILATV_PROGRESS_PATH=
