{
  "$defs": {
    "ClarifyingQuestion": {
      "additionalProperties": false,
      "description": "One N1 follow-up. Each question carries a recommended default.",
      "properties": {
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "recommended": {
          "minLength": 1,
          "title": "Recommended",
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "question",
        "recommended"
      ],
      "title": "ClarifyingQuestion",
      "type": "object"
    },
    "GenerationSettings": {
      "additionalProperties": false,
      "description": "Duration is the whole film, including any intro and outro packaging.",
      "properties": {
        "aspect_ratio": {
          "anyOf": [
            {
              "enum": [
                "16:9",
                "9:16",
                "1:1",
                "4:3",
                "3:4",
                "3:2",
                "2:3",
                "4:5",
                "21:9"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aspect Ratio"
        },
        "duration_s": {
          "anyOf": [
            {
              "ge": 5,
              "le": 180,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration S"
        }
      },
      "title": "GenerationSettings",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "brief_id": {
      "minLength": 1,
      "title": "Brief Id",
      "type": "string"
    },
    "raw_input": {
      "minLength": 1,
      "title": "Raw Input",
      "type": "string"
    },
    "goal": {
      "minLength": 1,
      "title": "Goal",
      "type": "string"
    },
    "platform": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Platform",
      "type": "array"
    },
    "duration_s": {
      "maximum": 180,
      "minimum": 5,
      "title": "Duration S",
      "type": "integer"
    },
    "aspect_ratios": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Aspect Ratios",
      "type": "array"
    },
    "languages": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Languages",
      "type": "array"
    },
    "video_type": {
      "minLength": 1,
      "title": "Video Type",
      "type": "string"
    },
    "audience": {
      "minLength": 1,
      "title": "Audience",
      "type": "string"
    },
    "must_include": {
      "items": {
        "type": "string"
      },
      "title": "Must Include",
      "type": "array"
    },
    "style": {
      "minLength": 1,
      "title": "Style",
      "type": "string"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "generation_settings": {
      "$ref": "#/$defs/GenerationSettings"
    },
    "open_questions": {
      "items": {
        "$ref": "#/$defs/ClarifyingQuestion"
      },
      "title": "Open Questions",
      "type": "array"
    }
  },
  "required": [
    "brief_id",
    "raw_input",
    "goal",
    "platform",
    "duration_s",
    "aspect_ratios",
    "languages",
    "video_type",
    "audience",
    "must_include",
    "style",
    "assumptions"
  ],
  "title": "Brief",
  "type": "object"
}
